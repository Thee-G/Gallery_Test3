  <div class="section-divider"></div>

  <!-- PAINTINGS -->
  <section id="paintings">
    <div class="section-header fade-up">
      <span class="section-num">02</span>
      <h2 class="section-title">Paintings &amp; <em>Illustrations</em></h2>
      <div class="section-line"></div>
    </div>
